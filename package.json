{
  "name": "unit-test-ide",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.4.0"
  },
  "scripts": {
    "build": "pnpm -r build && go build ./apps/test-service/...",
    "generate:protocol": "node tools/protocol-gen/generate.mjs",
    "check:protocol-generated": "node tools/protocol-gen/generate.mjs --check",
    "generate:coverage": "node tools/coverage-gen/generate.mjs",
    "check:coverage-generated": "node tools/coverage-gen/generate.mjs --check",
    "prepare:cmake-bundle": "node tools/cmake-bundle/prepare.mjs",
    "prepare:coverage-bundle": "node tools/coverage-bundle/prepare.mjs",
    "prepare:llvm-coverage-bundle": "node tools/llvm-coverage-bundle/prepare.mjs",
    "prepare:testgen-bundle": "node tools/testgen-bundle/prepare.mjs",
    "prepare:framework-bundle": "node tools/framework-bundle/prepare.mjs",
    "prepare:native-framework-runtime": "pnpm --filter @unit-test-ide/service-probe prepare:native-framework-runtime",
    "check:framework-bundle": "node tools/framework-bundle/check.mjs",
    "update:cmock-fixture": "node tools/framework-bundle/update-cmock-fixture.mjs",
    "verify:framework-fixtures": "node tools/framework-bundle/verify-fixtures.mjs",
    "prepare:release-manifest": "node tools/release/manifest.mjs --config tools/release/release-config.json",
    "release:stage": "node tools/release/stage.mjs",
    "check:coverage-bundle": "node tools/coverage-bundle/prepare.mjs --check",
    "check:llvm-coverage-bundle": "node tools/llvm-coverage-bundle/check.mjs",
    "check:testgen-bundle": "node tools/testgen-bundle/check.mjs",
    "test:coverage-gen": "node --test tools/coverage-gen/generate.test.mjs",
    "test:cmake-bundle": "node --test tools/cmake-bundle/prepare.test.mjs",
    "test:coverage-bundle": "node --test tools/coverage-bundle/manifest.test.mjs tools/coverage-bundle/prepare.test.mjs",
    "test:llvm-coverage-bundle": "node --test tools/llvm-coverage-bundle/manifest.test.mjs tools/llvm-coverage-bundle/prepare.test.mjs tools/llvm-coverage-bundle/check.test.mjs",
    "test:testgen-bundle": "node --test tools/testgen-bundle/manifest.test.mjs tools/testgen-bundle/prepare.test.mjs tools/testgen-bundle/check.test.mjs tools/release/stage.test.mjs",
    "test:framework-bundle": "node --test tools/framework-bundle/manifest.test.mjs tools/framework-bundle/prepare.test.mjs tools/framework-bundle/cmock-provenance.test.mjs tools/framework-bundle/check.test.mjs tools/framework-bundle/consume.test.mjs tools/framework-bundle/update-cmock-fixture.test.mjs tools/framework-bundle/verify-fixtures.test.mjs tools/linux-offline/run.test.mjs",
    "test:release-producer": "node --test tools/release/producer/source-manifest.test.mjs tools/release/producer/runtime-inventory.test.mjs tools/release/producer/provenance.test.mjs tools/release/producer/trusted-run.test.mjs tools/release/producer/workflow-contract.test.mjs",
    "check:phase9-gates": "node tools/phase9/render.mjs --registry tools/phase9/gates.json --baseline docs/superpowers/evidence/phase9/baseline.json --receipts docs/superpowers/evidence/phase9/receipts --repository-root . --json-out docs/superpowers/evidence/phase9/gate-matrix.json --markdown-out docs/superpowers/evidence/phase9/gate-matrix.md --check",
    "test:phase9-gates": "node --test tools/phase9/validate.test.mjs tools/phase9/audit.test.mjs",
    "test:native-framework-matrix": "node --test tools/phase9/p4-report.test.mjs",
    "test:phase9:performance": "tsc -b apps/code-oss-extension/tsconfig.json && node --test tools/phase9/performance.test.mjs",
    "test:workspace": "node --test tools/workspace-smoke/workspace-smoke.test.mjs tools/workspace-smoke/workspace-config-schema.test.mjs tools/workspace-smoke/unit-test-ide-cmake-helper.test.mjs",
    "test:go": "go test ./apps/test-service/...",
    "test:go:race": "go test -race -timeout=20m ./apps/test-service/...",
    "test": "pnpm run test:release-producer && pnpm run test:coverage-gen && pnpm run test:cmake-bundle && pnpm run test:coverage-bundle && pnpm run test:testgen-bundle && pnpm run test:framework-bundle && pnpm run test:phase9-gates && pnpm run test:native-framework-matrix && pnpm run test:phase10:test-generation && pnpm run test:workspace && pnpm -r --if-present test && pnpm run test:go",
    "test:e2e": "pnpm --filter @unit-test-ide/service-probe test:e2e",
    "test:phase10:test-generation": "node --test tools/phase10/test-generation-report.test.mjs tools/phase10/mutation.test.mjs tools/phase10/performance.test.mjs tools/phase10/security.test.mjs && node node_modules/typescript/bin/tsc -b tools/service-probe/tsconfig.json --pretty false && node --test tools/service-probe/dist/test-generation-e2e.test.js",
    "test:e2e:native": "pnpm --filter @unit-test-ide/service-probe test:e2e:native",
    "verify": "pnpm check:protocol-generated && pnpm check:coverage-generated && pnpm check:phase9-gates && pnpm check:framework-bundle && pnpm check:testgen-bundle && pnpm build && pnpm test && pnpm run test:phase10:test-generation && pnpm test:go:race && pnpm test:e2e"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "quicktype": "24.0.0",
    "typescript": "6.0.3"
  }
}
