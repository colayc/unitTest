              "$ref": "urn:unit-test-ide:protocol:v1.4:test#/$defs/testRunPage"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "coverageRunResponse": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/responseBase" }, { "type": "object", "properties": { "method": { "enum": ["coverage/runs/start", "coverage/runs/get"] }, "payload": { "$ref": "urn:unit-test-ide:protocol:v1.4:coverage#/$defs/coverageRun" } } }],
      "unevaluatedProperties": false
    },
    "coverageRunsListResponse": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/responseBase" }, { "type": "object", "properties": { "method": { "const": "coverage/runs/list" }, "payload": { "$ref": "urn:unit-test-ide:protocol:v1.4:coverage#/$defs/coverageRunPage" } } }],
      "unevaluatedProperties": false
    },
    "coverageReportResponse": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/responseBase" }, { "type": "object", "properties": { "method": { "const": "coverage/reports/get" }, "payload": { "$ref": "urn:unit-test-ide:protocol:v1.4:coverage#/$defs/coverageReport" } } }],
      "unevaluatedProperties": false
    },
    "coverageRunIdPayload": {
      "type": "object", "additionalProperties": false, "required": ["coverageRunId"],
      "properties": { "coverageRunId": { "$ref": "#/$defs/id32" } }
    },
    "coverageReportIdPayload": {
      "type": "object", "additionalProperties": false, "required": ["reportId"],
      "properties": { "reportId": { "$ref": "#/$defs/id32" } }
    },
    "coverageRunsListPayload": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "projectId": { "$ref": "#/$defs/projectId" },
        "coverageProfileId": { "$ref": "#/$defs/projectId" },
        "cursor": { "$ref": "#/$defs/cursor" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "taskStartPayload": {
      "oneOf": [
        {
          "$ref": "#/$defs/cmakeBuildStartPayload"
        },
        {
          "$ref": "#/$defs/simulationStartPayload"
        },
        {
          "$ref": "#/$defs/testDiscoveryStartPayload"
        },
        {
          "$ref": "#/$defs/testRunStartPayload"
        }
      ]
    },
    "cmakeBuildStartPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotencyKey",
        "kind",
        "workspaceGeneration",
        "projectId",
        "buildProfileId",
        "targetIds",
        "jobs",
        "timeoutMs"
      ],
      "properties": {
        "idempotencyKey": {
          "$ref": "#/$defs/id32"
        },
        "kind": {
          "const": "cmakeBuild"
        },
        "workspaceGeneration": {
          "$ref": "#/$defs/id64"
        },
        "projectId": {
          "$ref": "#/$defs/projectId"
        },
        "buildProfileId": {
          "$ref": "#/$defs/id64"
        },
        "targetIds": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id64"
          }
        },
        "jobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        }
      }
    },
    "simulationStartPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotencyKey",
        "kind",
        "scenario",
        "timeoutMs"
      ],
      "properties": {
        "idempotencyKey": {
          "$ref": "#/$defs/id32"
        },
        "kind": {
          "const": "simulation"
        },
        "scenario": {
          "enum": [
            "success",
            "exit-nonzero",
            "hang",
            "spawn-child",
            "emit-output"
          ]
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        }
      }
    },
    "testDiscoveryStartPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotencyKey",
        "kind",
        "projectId",
        "profileId"
      ],
      "properties": {
        "idempotencyKey": {
          "$ref": "#/$defs/id32"
        },
        "kind": {
          "const": "testDiscovery"
        },
        "projectId": {
          "$ref": "#/$defs/projectId"
        },
        "profileId": {
          "$ref": "#/$defs/id64"
        }
      }
    },
    "testRunStartPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotencyKey",
        "kind",
        "projectId",
        "profileId",
        "catalogRevision",
        "selection",
        "repeatCount"
      ],
      "properties": {
        "idempotencyKey": {
          "$ref": "#/$defs/id32"
        },
        "kind": {
          "const": "testRun"
        },
        "projectId": {
          "$ref": "#/$defs/projectId"
        },
        "profileId": {
          "$ref": "#/$defs/id64"
        },
        "catalogRevision": {
          "$ref": "#/$defs/id64"
        },
        "selection": {
          "$ref": "urn:unit-test-ide:protocol:v1.4:test#/$defs/testSelection"
        },
        "repeatCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "id32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "id64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "testPageLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "emptyPayload": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "error": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "error"
            },
            "requestId": {
              "$ref": "#/$defs/id32"
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "INVALID_MESSAGE",
                    "UNSUPPORTED_PROTOCOL",
                    "AUTH_REQUIRED",
                    "AUTH_FAILED",
                    "METHOD_NOT_FOUND",
                    "INVALID_TASK_SPEC",
                    "TASK_NOT_FOUND",
                    "IDEMPOTENCY_CONFLICT",
                    "EVENT_CURSOR_INVALID",
                    "ARTIFACT_NOT_FOUND",
                    "ARTIFACT_NOT_READY",
                    "STORAGE_UNAVAILABLE",
                    "SERVICE_UNHEALTHY",
                    "SUBSCRIBER_TOO_SLOW",
                    "PROTOCOL_FEATURE_UNAVAILABLE",
                    "WORKSPACE_CHANGED",
                    "PROJECT_NOT_FOUND",
                    "BUILD_PROFILE_NOT_FOUND",
                    "TARGET_NOT_FOUND",
                    "CONFIGURE_REQUIRED",
                    "WORKSPACE_TRUST_REQUIRED",
                    "TEST_CATALOG_NOT_FOUND",
                    "TEST_CATALOG_STALE",
                    "TEST_RUN_NOT_FOUND",
                    "TEST_SELECTION_INVALID",
                    "TEST_FRAMEWORK_UNAVAILABLE",
                    "COVERAGE_PROFILE_NOT_FOUND",
                    "COVERAGE_RUN_NOT_FOUND",
                    "COVERAGE_REPORT_NOT_FOUND"
                  ]
                },
                "message": {
                  "type": "string",
                  "maxLength": 8192
                },
                "retryable": {
                  "type": "boolean"
                }
              }
            }
          },
          "required": [
            "kind",
            "requestId",
            "error"
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
