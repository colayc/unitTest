{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unit-test-ide:protocol:v1.4:artifact",
  "title": "ArtifactMetadataV14",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactId",
    "taskId",
    "kind",
    "mimeType",
    "sizeBytes",
    "sha256",
    "createdAt",
    "uri"
  ],
  "properties": {
    "artifactId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "kind": {
      "title": "ArtifactKindV14",
      "enum": [
        "task-summary",
        "build-summary",
        "execution-plan",
        "diagnostics",
        "stdout",
        "stderr",
        "test-catalog",
        "test-selection",
        "test-run-summary",
        "test-results",
        "test-diagnostics",
        "test-output",
        "coverage-json",
        "junit-xml",
        "coverage-html"
      ]
    },
    "mimeType": {
      "title": "ArtifactMIMETypeV14",
      "enum": [
        "application/json",
        "application/x-ndjson",
        "application/octet-stream",
        "application/xml",
        "text/html"
      ]
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "uri": {
      "type": "string",
      "format": "uri"
    }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "coverage-json" } }, "required": ["kind"] }, "then": { "properties": { "mimeType": { "const": "application/json" } } } },
    { "if": { "properties": { "kind": { "const": "junit-xml" } }, "required": ["kind"] }, "then": { "properties": { "mimeType": { "const": "application/xml" } } } },
    { "if": { "properties": { "kind": { "const": "coverage-html" } }, "required": ["kind"] }, "then": { "properties": { "mimeType": { "const": "text/html" } } } }
  ]
}
