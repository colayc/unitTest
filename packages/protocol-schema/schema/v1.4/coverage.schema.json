{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unit-test-ide:protocol:v1.4:coverage",
  "title": "CoverageContractV14",
  "type": "object",
  "additionalProperties": false,
  "required": ["runStartRequest", "run", "runPage", "report"],
  "properties": {
    "runStartRequest": { "$ref": "#/$defs/coverageRunStartRequest" },
    "run": { "$ref": "#/$defs/coverageRun" },
    "runPage": { "$ref": "#/$defs/coverageRunPage" },
    "report": { "$ref": "#/$defs/coverageReport" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "coverageProfileId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "metric": {
      "title": "CoverageMetricV14",
      "type": "object",
      "additionalProperties": false,
      "required": ["covered", "total"],
      "properties": {
        "covered": { "$ref": "#/$defs/safeCount" },
        "total": { "$ref": "#/$defs/safeCount" }
      }
    },
    "summary": {
      "title": "CoverageSummaryV14",
      "type": "object",
      "additionalProperties": false,
      "required": ["lines", "branches", "functions"],
      "properties": {
        "lines": { "$ref": "#/$defs/metric" },
        "branches": { "$ref": "#/$defs/metric" },
        "functions": { "$ref": "#/$defs/metric" }
      }
    },
    "compiler": {
      "title": "CoverageCompilerV14",
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "version"],
      "properties": {
        "family": { "enum": ["gcc", "clang", "clang-cl"] },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "driver": {
      "title": "CoverageDriverV14",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "enum": ["gcov", "llvm-cov"] },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "collector": {
      "title": "CoverageCollectorV14",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "enum": ["gcovr", "llvm-cov"] },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "toolProvenance": {
      "title": "CoverageToolProvenanceV14",
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "compiler", "driver", "collector", "normalizerVersion", "instrumentationFingerprint"],
      "properties": {
        "platform": { "enum": ["windows", "linux"] },
        "architecture": { "enum": ["x86", "x64", "arm64"] },
        "compiler": { "$ref": "#/$defs/compiler" },
        "driver": { "$ref": "#/$defs/driver" },
        "collector": { "$ref": "#/$defs/collector" },
        "normalizerVersion": { "$ref": "#/$defs/version" },
        "instrumentationFingerprint": { "$ref": "#/$defs/revision" }
      }
    },
    "completeness": {
      "title": "CoverageCompletenessV14",
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reasons"],
      "properties": {
        "outcome": { "enum": ["available", "partial"] },
        "reasons": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "enum": ["test_crashed", "test_timed_out", "profile_missing_for_failed_invocation"] }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "available" } }, "required": ["outcome"] },
          "then": { "properties": { "reasons": { "type": "array", "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "outcome": { "const": "partial" } }, "required": ["outcome"] },
          "then": { "properties": { "reasons": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "coverageRunStartRequest": {
      "title": "CoverageRunStartRequestV14",
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "workspaceGeneration", "projectId", "coverageProfileId", "catalogRevision", "selection", "repeatCount", "timeoutMs"],
      "properties": {
        "idempotencyKey": { "$ref": "#/$defs/id" },
        "workspaceGeneration": { "$ref": "#/$defs/generation" },
        "projectId": { "$ref": "#/$defs/projectId" },
        "coverageProfileId": { "$ref": "#/$defs/coverageProfileId" },
        "catalogRevision": { "$ref": "#/$defs/revision" },
        "selection": { "$ref": "urn:unit-test-ide:protocol:v1.4:test#/$defs/testSelection" },
        "repeatCount": { "type": "integer", "minimum": 1, "maximum": 100 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 86400000 }
      }
    },
    "coverageRun": {
      "title": "CoverageRunV14",
      "type": "object",
      "additionalProperties": false,
      "required": ["coverageRunId", "testRunId", "workspaceGeneration", "projectId", "coverageProfileId", "catalogRevision", "selectionSnapshot", "repeatCount", "timeoutMs", "status", "createdAt", "lastSequence"],
      "properties": {
        "coverageRunId": { "$ref": "#/$defs/id" },
        "testRunId": { "$ref": "#/$defs/id" },
        "workspaceGeneration": { "$ref": "#/$defs/generation" },
        "projectId": { "$ref": "#/$defs/projectId" },
        "coverageProfileId": { "$ref": "#/$defs/coverageProfileId" },
        "catalogRevision": { "$ref": "#/$defs/revision" },
        "selectionSnapshot": { "$ref": "urn:unit-test-ide:protocol:v1.4:test#/$defs/selectionSnapshot" },
        "repeatCount": { "type": "integer", "minimum": 1, "maximum": 100 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "status": { "enum": ["queued", "running", "finished"] },
        "outcome": { "enum": ["available", "partial", "unavailable", "cancelled"] },
        "reason": { "enum": ["user_cancelled", "task_timed_out", "instrumentation_failed", "build_failed", "profile_collection_failed", "merge_failed", "normalization_failed", "report_generation_failed", "persistence_failed", "service_restarted"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "reportId": { "$ref": "#/$defs/id" },
        "lastSequence": { "$ref": "#/$defs/safeCount" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["queued", "running"] } }, "required": ["status"] },
          "then": { "not": { "anyOf": [{ "properties": { "outcome": {} }, "required": ["outcome"] }, { "properties": { "reason": {} }, "required": ["reason"] }, { "properties": { "finishedAt": {} }, "required": ["finishedAt"] }, { "properties": { "reportId": {} }, "required": ["reportId"] }] } }
        },
        {
          "if": { "properties": { "status": { "const": "finished" } }, "required": ["status"] },
          "then": { "properties": { "outcome": {}, "finishedAt": {} }, "required": ["outcome", "finishedAt"] }
        },
        {
          "if": { "properties": { "outcome": { "enum": ["available", "partial"] } }, "required": ["outcome"] },
          "then": { "properties": { "reportId": {} }, "required": ["reportId"], "not": { "properties": { "reason": {} }, "required": ["reason"] } }
        },
        {
          "if": { "properties": { "outcome": { "const": "unavailable" } }, "required": ["outcome"] },
          "then": { "required": ["reason"], "properties": { "reason": { "enum": ["instrumentation_failed", "build_failed", "profile_collection_failed", "merge_failed", "normalization_failed", "report_generation_failed", "persistence_failed", "service_restarted"] } }, "not": { "properties": { "reportId": {} }, "required": ["reportId"] } }
        },
        {
          "if": { "properties": { "outcome": { "const": "cancelled" } }, "required": ["outcome"] },
          "then": { "required": ["reason"], "properties": { "reason": { "enum": ["user_cancelled", "task_timed_out"] } }, "not": { "properties": { "reportId": {} }, "required": ["reportId"] } }
        }
      ]
    },
    "coverageRunPage": {
      "title": "CoverageRunPageV14",
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/coverageRun" } },
        "nextCursor": { "$ref": "#/$defs/cursor" }
      }
    },
    "coverageReport": {
      "title": "CoverageReportV14",
      "type": "object",
      "additionalProperties": false,
      "required": ["reportId", "coverageRunId", "testRunId", "schemaVersion", "createdAt", "completeness", "summary", "toolProvenance", "artifactId"],
      "properties": {
        "reportId": { "$ref": "#/$defs/id" },
        "coverageRunId": { "$ref": "#/$defs/id" },
        "testRunId": { "$ref": "#/$defs/id" },
        "schemaVersion": { "const": "1.0" },
        "createdAt": { "type": "string", "format": "date-time" },
        "completeness": { "$ref": "#/$defs/completeness" },
        "summary": { "$ref": "#/$defs/summary" },
        "toolProvenance": { "$ref": "#/$defs/toolProvenance" },
        "artifactId": { "$ref": "#/$defs/id" }
      }
    }
  }
}
