{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unit-test-ide:protocol:v1.2:event",
  "title": "TaskEventV12",
  "oneOf": [
    { "$ref": "#/$defs/diagnosticEvent" },
    { "$ref": "#/$defs/stepStartedEvent" },
    { "$ref": "#/$defs/stepFinishedEvent" },
    { "$ref": "#/$defs/emptyEvent" }
  ],
  "$defs": {
    "diagnosticEvent": {
      "title": "TaskDiagnosticEventV12",
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "kind", "messageId", "sentAt", "sequence", "event", "taskId", "payloadVersion", "payload"],
      "properties": {
        "protocolVersion": { "title": "EventProtocolVersionV12", "const": "1.2" },
        "kind": { "title": "EventKindV12", "const": "event" },
        "messageId": { "type": "string", "pattern": "^[0-9a-f]{32}$" }, "sentAt": { "type": "string", "format": "date-time" }, "sequence": { "type": "integer", "minimum": 1 },
        "event": { "title": "TaskEventNameV12", "const": "task.diagnostic" }, "taskId": { "type": "string", "pattern": "^[0-9a-f]{32}$" }, "payloadVersion": { "const": 1 },
        "payload": { "$ref": "#/$defs/diagnosticPayload" }
      }
    },
    "stepStartedEvent": {
      "title": "TaskStepStartedEventV12",
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "kind", "messageId", "sentAt", "sequence", "event", "taskId", "payloadVersion", "payload"],
      "properties": {
        "protocolVersion": { "title": "EventProtocolVersionV12", "const": "1.2" }, "kind": { "title": "EventKindV12", "const": "event" },
        "messageId": { "type": "string", "pattern": "^[0-9a-f]{32}$" }, "sentAt": { "type": "string", "format": "date-time" }, "sequence": { "type": "integer", "minimum": 1 },
        "event": { "title": "TaskEventNameV12", "const": "task.step_started" }, "taskId": { "type": "string", "pattern": "^[0-9a-f]{32}$" }, "payloadVersion": { "const": 1 },
        "payload": { "$ref": "#/$defs/stepStartedPayload" }
      }
    },
    "stepFinishedEvent": {
      "title": "TaskStepFinishedEventV12",
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "kind", "messageId", "sentAt", "sequence", "event", "taskId", "payloadVersion", "payload"],
      "properties": {
        "protocolVersion": { "title": "EventProtocolVersionV12", "const": "1.2" }, "kind": { "title": "EventKindV12", "const": "event" },
        "messageId": { "type": "string", "pattern": "^[0-9a-f]{32}$" }, "sentAt": { "type": "string", "format": "date-time" }, "sequence": { "type": "integer", "minimum": 1 },
        "event": { "title": "TaskEventNameV12", "const": "task.step_finished" }, "taskId": { "type": "string", "pattern": "^[0-9a-f]{32}$" }, "payloadVersion": { "const": 1 },
        "payload": { "$ref": "#/$defs/stepFinishedPayload" }
      }
    },
    "emptyEvent": {
      "title": "TaskEmptyEventV12",
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "kind", "messageId", "sentAt", "sequence", "event", "taskId", "payloadVersion", "payload"],
      "properties": {
        "protocolVersion": { "title": "EventProtocolVersionV12", "const": "1.2" }, "kind": { "title": "EventKindV12", "const": "event" },
        "messageId": { "type": "string", "pattern": "^[0-9a-f]{32}$" }, "sentAt": { "type": "string", "format": "date-time" }, "sequence": { "type": "integer", "minimum": 1 },
        "event": { "title": "TaskEventNameV12", "enum": ["task.created", "task.started", "task.output", "task.cancellation_requested", "task.finished", "artifact.created"] }, "taskId": { "type": "string", "pattern": "^[0-9a-f]{32}$" }, "payloadVersion": { "const": 1 },
        "payload": { "$ref": "#/$defs/emptyPayload" }
      }
    },
    "emptyPayload": { "title": "TaskEmptyEventPayloadV12", "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "diagnosticPayload": { "title": "TaskDiagnosticPayloadV12", "type": "object", "additionalProperties": false, "required": ["diagnostic"], "properties": { "diagnostic": { "$ref": "#/$defs/eventDiagnostic" } } },
    "eventDiagnostic": { "title": "TaskEventDiagnosticV12", "type": "object", "additionalProperties": false, "required": ["severity", "code", "message"], "properties": { "severity": { "title": "TaskEventDiagnosticSeverityV12", "enum": ["error", "warning", "info"] }, "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 }, "sourceUri": { "type": "string", "format": "uri" }, "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 } } },
    "stepStartedPayload": { "title": "TaskStepStartedPayloadV12", "type": "object", "additionalProperties": false, "required": ["step"], "properties": { "step": { "title": "TaskStepNameV12", "enum": ["configure", "build"] } } },
    "stepFinishedPayload": { "title": "TaskStepFinishedPayloadV12", "type": "object", "additionalProperties": false, "required": ["step", "outcome"], "properties": { "step": { "title": "TaskStepNameV12", "enum": ["configure", "build"] }, "outcome": { "title": "TaskStepOutcomeV12", "enum": ["succeeded", "command_failed", "cancelled", "timed_out", "interrupted", "infrastructure_failed"] } } }
  }
}
