{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unit-test-ide:protocol:v1.3:artifact",
  "title": "ArtifactMetadataV13",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactId",
    "taskId",
    "kind",
    "mimeType",
    "sizeBytes",
    "sha256",
    "createdAt",
    "uri"
  ],
  "properties": {
    "artifactId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "kind": {
      "title": "ArtifactKindV13",
      "enum": [
        "task-summary",
        "build-summary",
        "execution-plan",
        "diagnostics",
        "stdout",
        "stderr",
        "test-catalog",
        "test-run-summary",
        "test-results",
        "test-diagnostics",
        "test-output"
      ]
    },
    "mimeType": {
      "title": "ArtifactMIMETypeV13",
      "enum": [
        "application/json",
        "application/x-ndjson",
        "application/octet-stream"
      ]
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "uri": {
      "type": "string",
      "format": "uri"
    }
  }
}
