              "$ref": "#/$defs/taskFinishedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "diagnosticEvent": {
      "title": "TaskDiagnosticEventV13",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "task.diagnostic"
            },
            "payload": {
              "$ref": "#/$defs/diagnosticPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "testDiscoveryStartedEvent": {
      "title": "TestDiscoveryStartedEventV13",
      "type": "object",
      "allOf": [
