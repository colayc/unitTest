            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "taskCreatedPayload": {
      "title": "TaskCreatedPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "queued"
        }
      }
    },
    "taskStartedPayload": {
      "title": "TaskStartedPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "running"
        }
      }
    },
    "stepStartedPayload": {
      "title": "TaskStepStartedPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "kind",
        "status"
      ],
      "properties": {
        "stepId": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_-]{0,63}$"
        },
        "kind": {
          "$ref": "#/$defs/stepKind"
        },
        "status": {
          "const": "running"
        }
      }
    },
    "outputPayload": {
      "title": "TaskOutputPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "stream",
        "text",
        "truncated"
      ],
      "properties": {
        "stepId": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_-]{0,63}$"
        },
        "stream": {
          "$ref": "#/$defs/outputStream"
        },
        "text": {
          "type": "string",
          "maxLength": 262144
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "stepFinishedPayload": {
      "title": "TaskStepFinishedPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "kind",
        "status"
      ],
      "properties": {
        "stepId": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_-]{0,63}$"
        },
        "kind": {
          "$ref": "#/$defs/stepKind"
        },
        "status": {
          "title": "TaskStepFinishedStatusV13",
          "enum": [
            "succeeded",
            "failed",
            "skipped"
          ]
        },
        "exitCode": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "errorCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "cancellationRequestedPayload": {
      "title": "TaskCancellationRequestedPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "cancelling"
        }
      }
    },
    "artifactCreatedPayload": {
      "title": "ArtifactCreatedPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "kind"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/artifactId"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "taskFinishedPayload": {
      "title": "TaskFinishedPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "$ref": "#/$defs/taskOutcome"
        }
      }
    },
    "diagnosticPayload": {
      "title": "TaskDiagnosticPayloadV13",
      "type": "object",
