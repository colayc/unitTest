          "$ref": "urn:unit-test-ide:protocol:v1.3:diagnostic"
        }
      }
    },
    "testDiscoveryStartedPayload": {
      "title": "TestDiscoveryStartedPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "profileId"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/$defs/projectId"
        },
        "profileId": {
          "$ref": "#/$defs/profileId"
        }
      }
    },
    "testContainerDiscoveredPayload": {
      "title": "TestContainerDiscoveredPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerId",
        "framework",
        "displayName"
      ],
      "properties": {
        "containerId": {
          "$ref": "#/$defs/stableId"
        },
        "framework": {
          "$ref": "#/$defs/testFramework"
        },
        "displayName": {
          "$ref": "#/$defs/boundedName"
        }
      }
    },
    "testCatalogPublishedPayload": {
      "title": "TestCatalogPublishedPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "profileId",
        "revision",
        "containerCount",
        "itemCount"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/$defs/projectId"
        },
        "profileId": {
          "$ref": "#/$defs/profileId"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "containerCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "itemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "testRunStartedPayload": {
      "title": "TestRunStartedPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "catalogRevision",
        "total"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "catalogRevision": {
          "$ref": "#/$defs/revision"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "testContainerStartedPayload": {
      "title": "TestContainerStartedPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "containerId",
        "iteration"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "containerId": {
          "$ref": "#/$defs/stableId"
        },
        "iteration": {
          "$ref": "#/$defs/iteration"
        }
      }
    },
    "testItemStartedPayload": {
      "title": "TestItemStartedPayloadV13",
      "type": "object",
