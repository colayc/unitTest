        "iteration"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "itemId": {
          "$ref": "#/$defs/stableId"
        },
        "containerId": {
          "$ref": "#/$defs/stableId"
        },
        "iteration": {
          "$ref": "#/$defs/iteration"
        }
      }
    },
    "testOutputPayload": {
      "title": "TestOutputPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "containerId",
        "iteration",
        "stream",
        "text",
        "truncated"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "containerId": {
          "$ref": "#/$defs/stableId"
        },
        "itemId": {
          "$ref": "#/$defs/stableId"
        },
        "iteration": {
          "$ref": "#/$defs/iteration"
        },
        "stream": {
          "$ref": "#/$defs/outputStream"
        },
        "text": {
          "type": "string",
          "maxLength": 262144
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "testItemFinishedPayload": {
      "title": "TestItemFinishedPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "result"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "result": {
          "$ref": "urn:unit-test-ide:protocol:v1.3:test#/$defs/testItemResult"
        }
      }
    },
    "testContainerFinishedPayload": {
      "title": "TestContainerFinishedPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "containerId",
        "iteration",
        "outcome"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "containerId": {
          "$ref": "#/$defs/stableId"
        },
        "iteration": {
          "$ref": "#/$defs/iteration"
        },
        "outcome": {
          "title": "TestContainerOutcomeV13",
          "enum": [
            "passed",
            "failed",
            "errored",
            "cancelled",
            "timed_out",
            "not_run"
          ]
        }
      }
    },
    "testRunFinishedPayload": {
      "title": "TestRunFinishedPayloadV13",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "outcome",
        "summary",
        "resultRevision",
        "incomplete"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "outcome": {
          "$ref": "#/$defs/testRunOutcome"
        },
        "summary": {
          "$ref": "urn:unit-test-ide:protocol:v1.3:test#/$defs/testRunSummary"
        },
        "resultRevision": {
          "$ref": "#/$defs/revision"
        },
        "incomplete": {
          "type": "boolean"
        }
      }
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^utid-v1-[0-9a-f]{64}$"
    },
    "boundedName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "testFramework": {
      "title": "TestEventFrameworkV13",
      "enum": [
        "cpputest",
        "unity",
        "opaque-ctest"
      ]
    },
    "outputStream": {
      "title": "TaskOutputStreamV13",
      "enum": [
        "stdout",
        "stderr",
        "combined"
      ]
    },
    "stepKind": {
      "title": "TaskStepKindV13",
      "enum": [
        "simulation",
        "configure",
        "build",
        "test-discovery",
        "test-run"
