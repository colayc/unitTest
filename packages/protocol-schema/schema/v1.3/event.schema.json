{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unit-test-ide:protocol:v1.3:event",
  "title": "TaskEventV13",
  "oneOf": [
    {
      "$ref": "#/$defs/taskCreatedEvent"
    },
    {
      "$ref": "#/$defs/taskStartedEvent"
    },
    {
      "$ref": "#/$defs/stepStartedEvent"
    },
    {
      "$ref": "#/$defs/outputEvent"
    },
    {
      "$ref": "#/$defs/stepFinishedEvent"
    },
    {
      "$ref": "#/$defs/cancellationRequestedEvent"
    },
    {
      "$ref": "#/$defs/artifactCreatedEvent"
    },
    {
      "$ref": "#/$defs/taskFinishedEvent"
    },
    {
      "$ref": "#/$defs/diagnosticEvent"
    },
    {
      "$ref": "#/$defs/testDiscoveryStartedEvent"
    },
    {
      "$ref": "#/$defs/testContainerDiscoveredEvent"
    },
    {
      "$ref": "#/$defs/testCatalogPublishedEvent"
    },
    {
      "$ref": "#/$defs/testRunStartedEvent"
    },
    {
      "$ref": "#/$defs/testContainerStartedEvent"
    },
    {
      "$ref": "#/$defs/testItemStartedEvent"
    },
    {
      "$ref": "#/$defs/testOutputEvent"
    },
    {
      "$ref": "#/$defs/testItemFinishedEvent"
    },
    {
      "$ref": "#/$defs/testContainerFinishedEvent"
    },
    {
      "$ref": "#/$defs/testRunFinishedEvent"
    }
  ],
  "$defs": {
    "eventBase": {
      "type": "object",
      "required": [
        "protocolVersion",
        "kind",
        "messageId",
        "sentAt",
        "sequence",
        "event",
        "taskId",
        "payloadVersion",
        "payload"
      ],
      "properties": {
        "protocolVersion": {
          "title": "EventProtocolVersionV13",
          "const": "1.3"
        },
        "kind": {
          "title": "EventKindV13",
          "const": "event"
        },
        "messageId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "sentAt": {
          "type": "string",
          "format": "date-time"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "event": {
          "title": "TaskEventNameV13",
          "enum": [
            "task.created",
            "task.started",
            "task.step_started",
            "task.output",
            "task.step_finished",
            "task.cancellation_requested",
            "artifact.created",
            "task.finished",
            "task.diagnostic",
            "test.discovery.started",
            "test.container.discovered",
            "test.catalog.published",
            "test.run.started",
            "test.container.started",
            "test.item.started",
            "test.output",
            "test.item.finished",
            "test.container.finished",
            "test.run.finished"
          ]
        },
        "taskId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "payloadVersion": {
          "const": 1
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "taskCreatedEvent": {
      "title": "TaskCreatedEventV13",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "task.created"
            },
            "payload": {
              "$ref": "#/$defs/taskCreatedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "taskStartedEvent": {
      "title": "TaskStartedEventV13",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "task.started"
            },
            "payload": {
              "$ref": "#/$defs/taskStartedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stepStartedEvent": {
      "title": "TaskStepStartedEventV13",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "task.step_started"
            },
            "payload": {
              "$ref": "#/$defs/stepStartedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "outputEvent": {
      "title": "TaskOutputEventV13",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
