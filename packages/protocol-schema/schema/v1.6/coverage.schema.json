{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unit-test-ide:protocol:v1.6:coverage",
  "title": "CoverageContractV16",
  "type": "object",
  "additionalProperties": false,
  "required": ["runStartRequest", "run", "runPage", "report", "detailProject", "filePage", "functionPage", "linePage", "detailProjectRequest", "detailFilesRequest", "detailFunctionsRequest", "detailLinesRequest"],
  "properties": {
    "runStartRequest": { "$ref": "#/$defs/coverageRunStartRequest" },
    "run": { "$ref": "#/$defs/coverageRun" },
    "runPage": { "$ref": "#/$defs/coverageRunPage" },
    "report": { "$ref": "#/$defs/coverageReport" },
    "detailProject": { "$ref": "#/$defs/detailProject" },
    "filePage": { "$ref": "#/$defs/filePage" },
    "functionPage": { "$ref": "#/$defs/functionPage" },
    "linePage": { "$ref": "#/$defs/linePage" },
    "detailProjectRequest": { "$ref": "#/$defs/detailProjectRequest" },
    "detailFilesRequest": { "$ref": "#/$defs/detailFilesRequest" },
    "detailFunctionsRequest": { "$ref": "#/$defs/detailFunctionsRequest" },
    "detailLinesRequest": { "$ref": "#/$defs/detailLinesRequest" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "coverageProfileId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00]+$"
    },
    "metric": {
      "title": "CoverageMetricV16",
      "type": "object",
      "additionalProperties": false,
      "required": ["covered", "total"],
      "properties": {
        "covered": { "$ref": "#/$defs/safeCount" },
        "total": { "$ref": "#/$defs/safeCount" }
      }
    },
    "summary": {
      "title": "CoverageSummaryV16",
      "type": "object",
      "additionalProperties": false,
      "required": ["lines", "branches", "functions"],
      "properties": {
        "lines": { "$ref": "#/$defs/metric" },
        "branches": { "$ref": "#/$defs/metric" },
        "functions": { "$ref": "#/$defs/metric" }
      }
    },
    "sourceSnapshot": {
      "title": "CoverageSourceSnapshotV16",
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\x00/\\\\]+(?:/[^\\x00/\\\\]+)*$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "compiler": {
      "title": "CoverageCompilerV16",
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "version"],
      "properties": {
        "family": { "enum": ["gcc", "clang", "clang-cl"] },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "driver": {
      "title": "CoverageDriverV16",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "enum": ["gcov", "llvm-cov"] },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "collector": {
      "title": "CoverageCollectorV16",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "enum": ["gcovr", "llvm-cov"] },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "toolProvenance": {
      "title": "CoverageToolProvenanceV16",
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "compiler", "driver", "collector", "normalizerVersion", "instrumentationFingerprint"],
      "properties": {
        "platform": { "enum": ["windows", "linux"] },
        "architecture": { "enum": ["x86", "x64", "arm64"] },
        "compiler": { "$ref": "#/$defs/compiler" },
        "driver": { "$ref": "#/$defs/driver" },
        "collector": { "$ref": "#/$defs/collector" },
        "normalizerVersion": { "$ref": "#/$defs/version" },
        "instrumentationFingerprint": { "$ref": "#/$defs/revision" }
      }
    },
    "completeness": {
      "title": "CoverageCompletenessV16",
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reasons"],
      "properties": {
        "outcome": { "enum": ["available", "partial"] },
        "reasons": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "enum": ["test_crashed", "test_timed_out", "profile_missing_for_failed_invocation"] }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "available" } }, "required": ["outcome"] },
          "then": { "properties": { "reasons": { "type": "array", "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "outcome": { "const": "partial" } }, "required": ["outcome"] },
          "then": { "properties": { "reasons": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "coverageRunStartRequest": {
      "title": "CoverageRunStartRequestV16",
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "workspaceGeneration", "projectId", "coverageProfileId", "catalogRevision", "selection", "repeatCount", "timeoutMs"],
      "properties": {
        "idempotencyKey": { "$ref": "#/$defs/id" },
        "workspaceGeneration": { "$ref": "#/$defs/generation" },
        "projectId": { "$ref": "#/$defs/projectId" },
        "coverageProfileId": { "$ref": "#/$defs/coverageProfileId" },
        "catalogRevision": { "$ref": "#/$defs/revision" },
        "selection": { "$ref": "urn:unit-test-ide:protocol:v1.6:test#/$defs/testSelection" },
        "repeatCount": { "type": "integer", "minimum": 1, "maximum": 100 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 86400000 }
      }
    },
    "coverageRun": {
      "title": "CoverageRunV16",
      "type": "object",
      "additionalProperties": false,
      "required": ["coverageRunId", "taskId", "testRunId", "workspaceGeneration", "projectId", "coverageProfileId", "catalogRevision", "selectionSnapshot", "repeatCount", "timeoutMs", "status", "createdAt", "lastSequence"],
      "properties": {
        "coverageRunId": { "$ref": "#/$defs/id" },
        "taskId": { "$ref": "#/$defs/id" },
        "testRunId": { "$ref": "#/$defs/id" },
        "workspaceGeneration": { "$ref": "#/$defs/generation" },
        "projectId": { "$ref": "#/$defs/projectId" },
        "coverageProfileId": { "$ref": "#/$defs/coverageProfileId" },
        "catalogRevision": { "$ref": "#/$defs/revision" },
        "selectionSnapshot": { "$ref": "urn:unit-test-ide:protocol:v1.6:test#/$defs/selectionSnapshot" },
        "repeatCount": { "type": "integer", "minimum": 1, "maximum": 100 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "status": { "enum": ["queued", "running", "finished"] },
        "outcome": { "enum": ["available", "partial", "unavailable", "cancelled"] },
        "reason": { "enum": ["user_cancelled", "task_timed_out", "instrumentation_failed", "build_failed", "profile_collection_failed", "merge_failed", "normalization_failed", "report_generation_failed", "persistence_failed", "service_restarted"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "reportId": { "$ref": "#/$defs/id" },
        "lastSequence": { "$ref": "#/$defs/safeCount" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["queued", "running"] } }, "required": ["status"] },
          "then": { "not": { "anyOf": [{ "properties": { "outcome": {} }, "required": ["outcome"] }, { "properties": { "reason": {} }, "required": ["reason"] }, { "properties": { "finishedAt": {} }, "required": ["finishedAt"] }, { "properties": { "reportId": {} }, "required": ["reportId"] }] } }
        },
        {
          "if": { "properties": { "status": { "const": "finished" } }, "required": ["status"] },
          "then": { "properties": { "outcome": {}, "finishedAt": {} }, "required": ["outcome", "finishedAt"] }
        },
        {
          "if": { "properties": { "outcome": { "enum": ["available", "partial"] } }, "required": ["outcome"] },
          "then": { "properties": { "reportId": {} }, "required": ["reportId"], "not": { "properties": { "reason": {} }, "required": ["reason"] } }
        },
        {
          "if": { "properties": { "outcome": { "const": "unavailable" } }, "required": ["outcome"] },
          "then": { "required": ["reason"], "properties": { "reason": { "enum": ["instrumentation_failed", "build_failed", "profile_collection_failed", "merge_failed", "normalization_failed", "report_generation_failed", "persistence_failed", "service_restarted"] } }, "not": { "properties": { "reportId": {} }, "required": ["reportId"] } }
        },
        {
          "if": { "properties": { "outcome": { "const": "cancelled" } }, "required": ["outcome"] },
          "then": { "required": ["reason"], "properties": { "reason": { "enum": ["user_cancelled", "task_timed_out"] } }, "not": { "properties": { "reportId": {} }, "required": ["reportId"] } }
        }
      ]
    },
    "coverageRunPage": {
      "title": "CoverageRunPageV16",
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/coverageRun" } },
        "nextCursor": { "$ref": "#/$defs/cursor" }
      }
    },
    "detailStatus": { "title": "CoverageDetailStatusV16", "enum": ["current", "stale", "incomplete"] },
    "detailReason": { "title": "CoverageDetailReasonV16", "enum": ["source_changed", "tool_identity_changed", "report_partial", "attribution_ambiguous", "baseline_unavailable", "source_missing"] },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$" },
    "signedCount": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "detailMetric": {
      "title": "CoverageMetricV16", "type": "object", "additionalProperties": false,
      "required": ["covered", "total", "coveredDelta"],
      "properties": { "covered": { "$ref": "#/$defs/safeCount" }, "total": { "$ref": "#/$defs/safeCount" }, "coveredDelta": { "$ref": "#/$defs/signedCount" } }
    },
    "detailSummary": {
      "title": "CoverageSummaryV16", "type": "object", "additionalProperties": false,
      "required": ["functions", "lines", "branches"],
      "properties": { "functions": { "$ref": "#/$defs/detailMetric" }, "lines": { "$ref": "#/$defs/detailMetric" }, "branches": { "$ref": "#/$defs/detailMetric" } }
    },
    "detailProjectRequest": {
      "title": "CoverageDetailProjectRequestV16", "type": "object", "additionalProperties": false,
      "required": ["workspaceGeneration", "coverageReportId", "projectId"],
      "properties": { "workspaceGeneration": { "$ref": "#/$defs/generation" }, "coverageReportId": { "$ref": "#/$defs/id" }, "projectId": { "$ref": "#/$defs/projectId" } }
    },
    "detailFilesRequest": {
      "title": "CoverageDetailFilesRequestV16", "type": "object", "additionalProperties": false,
      "required": ["workspaceGeneration", "coverageReportId", "projectId"],
      "properties": { "workspaceGeneration": { "$ref": "#/$defs/generation" }, "coverageReportId": { "$ref": "#/$defs/id" }, "projectId": { "$ref": "#/$defs/projectId" }, "cursor": { "$ref": "#/$defs/cursor" }, "limit": { "type": "integer", "minimum": 1, "maximum": 200 } }
    },
    "detailFunctionsRequest": {
      "title": "CoverageDetailFunctionsRequestV16", "type": "object", "additionalProperties": false,
      "required": ["workspaceGeneration", "coverageReportId", "fileId"],
      "properties": { "workspaceGeneration": { "$ref": "#/$defs/generation" }, "coverageReportId": { "$ref": "#/$defs/id" }, "fileId": { "$ref": "#/$defs/id" }, "cursor": { "$ref": "#/$defs/cursor" }, "limit": { "type": "integer", "minimum": 1, "maximum": 200 } }
    },
    "detailLinesRequest": {
      "title": "CoverageDetailLinesRequestV16", "type": "object", "additionalProperties": false,
      "required": ["workspaceGeneration", "coverageReportId"],
      "properties": { "workspaceGeneration": { "$ref": "#/$defs/generation" }, "coverageReportId": { "$ref": "#/$defs/id" }, "fileId": { "$ref": "#/$defs/id" }, "functionId": { "$ref": "#/$defs/id" }, "cursor": { "$ref": "#/$defs/cursor" }, "limit": { "type": "integer", "minimum": 1, "maximum": 1000 } },
      "oneOf": [{ "required": ["fileId"], "not": { "required": ["functionId"] } }, { "required": ["functionId"], "not": { "required": ["fileId"] } }]
    },
    "detailProject": {
      "title": "CoverageProjectV16", "type": "object", "additionalProperties": false,
      "required": ["workspaceGeneration", "coverageReportId", "projectId", "status", "reasons", "summary", "fileCount"],
      "properties": { "workspaceGeneration": { "$ref": "#/$defs/generation" }, "coverageReportId": { "$ref": "#/$defs/id" }, "projectId": { "$ref": "#/$defs/projectId" }, "status": { "$ref": "#/$defs/detailStatus" }, "reasons": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/detailReason" } }, "summary": { "$ref": "#/$defs/detailSummary" }, "fileCount": { "$ref": "#/$defs/safeCount" } }
    },
    "detailFile": {
      "title": "CoverageFileV16", "type": "object", "additionalProperties": false,
      "required": ["fileId", "relativePath", "sourceSha256", "status", "reasons", "summary", "functionCount"],
      "properties": { "fileId": { "$ref": "#/$defs/id" }, "relativePath": { "$ref": "#/$defs/relativePath" }, "sourceSha256": { "$ref": "#/$defs/revision" }, "status": { "$ref": "#/$defs/detailStatus" }, "reasons": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/detailReason" } }, "summary": { "$ref": "#/$defs/detailSummary" }, "functionCount": { "$ref": "#/$defs/safeCount" } }
    },
    "detailFunction": {
      "title": "CoverageFunctionV16", "type": "object", "additionalProperties": false,
      "required": ["functionId", "fileId", "qualifiedName", "startLine", "endLine", "status", "reasons", "summary"],
      "properties": { "functionId": { "$ref": "#/$defs/id" }, "fileId": { "$ref": "#/$defs/id" }, "coverageGapId": { "$ref": "#/$defs/id" }, "qualifiedName": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\x00\\r\\n]+$" }, "startLine": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "endLine": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "status": { "$ref": "#/$defs/detailStatus" }, "reasons": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/detailReason" } }, "summary": { "$ref": "#/$defs/detailSummary" } }
    },
    "lineDetail": {
      "title": "CoverageLineDetailV16", "type": "object", "additionalProperties": false,
      "required": ["line", "count", "baselineCount", "branchesCovered", "branchesTotal", "baselineBranchesCovered", "baselineBranchesTotal"],
      "properties": { "line": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "coverageGapId": { "$ref": "#/$defs/id" }, "count": { "$ref": "#/$defs/safeCount" }, "baselineCount": { "$ref": "#/$defs/safeCount" }, "branchesCovered": { "$ref": "#/$defs/safeCount" }, "branchesTotal": { "$ref": "#/$defs/safeCount" }, "baselineBranchesCovered": { "$ref": "#/$defs/safeCount" }, "baselineBranchesTotal": { "$ref": "#/$defs/safeCount" } }
    },
    "filePage": {
      "title": "CoverageFilePageV16", "type": "object", "additionalProperties": false,
      "required": ["workspaceGeneration", "coverageReportId", "items"],
      "properties": { "workspaceGeneration": { "$ref": "#/$defs/generation" }, "coverageReportId": { "$ref": "#/$defs/id" }, "items": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/detailFile" } }, "nextCursor": { "$ref": "#/$defs/cursor" } }
    },
    "functionPage": {
      "title": "CoverageFunctionPageV16", "type": "object", "additionalProperties": false,
      "required": ["workspaceGeneration", "coverageReportId", "items"],
      "properties": { "workspaceGeneration": { "$ref": "#/$defs/generation" }, "coverageReportId": { "$ref": "#/$defs/id" }, "items": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/detailFunction" } }, "nextCursor": { "$ref": "#/$defs/cursor" } }
    },
    "linePage": {
      "title": "CoverageLinePageV16", "type": "object", "additionalProperties": false,
      "required": ["workspaceGeneration", "coverageReportId", "items"],
      "properties": { "workspaceGeneration": { "$ref": "#/$defs/generation" }, "coverageReportId": { "$ref": "#/$defs/id" }, "items": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/lineDetail" } }, "nextCursor": { "$ref": "#/$defs/cursor" } }
    },
    "coverageReport": {
      "title": "CoverageReportV16",
      "type": "object",
      "additionalProperties": false,
      "required": ["reportId", "coverageRunId", "testRunId", "schemaVersion", "createdAt", "completeness", "summary", "toolProvenance", "artifactId"],
      "properties": {
        "reportId": { "$ref": "#/$defs/id" },
        "coverageRunId": { "$ref": "#/$defs/id" },
        "testRunId": { "$ref": "#/$defs/id" },
        "schemaVersion": { "const": "1.0" },
        "createdAt": { "type": "string", "format": "date-time" },
        "completeness": { "$ref": "#/$defs/completeness" },
        "summary": { "$ref": "#/$defs/summary" },
        "toolProvenance": { "$ref": "#/$defs/toolProvenance" },
        "artifactId": { "$ref": "#/$defs/id" },
        "sources": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/sourceSnapshot" } }
      }
    }
  }
}
