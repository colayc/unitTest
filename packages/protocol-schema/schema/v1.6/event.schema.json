{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unit-test-ide:protocol:v1.6:event",
  "title": "TaskEventV16",
  "oneOf": [
    {
      "$ref": "#/$defs/taskCreatedEvent"
    },
    {
      "$ref": "#/$defs/taskStartedEvent"
    },
    {
      "$ref": "#/$defs/stepStartedEvent"
    },
    {
      "$ref": "#/$defs/outputEvent"
    },
    {
      "$ref": "#/$defs/stepFinishedEvent"
    },
    {
      "$ref": "#/$defs/cancellationRequestedEvent"
    },
    {
      "$ref": "#/$defs/artifactCreatedEvent"
    },
    {
      "$ref": "#/$defs/taskFinishedEvent"
    },
    {
      "$ref": "#/$defs/diagnosticEvent"
    },
    {
      "$ref": "#/$defs/testDiscoveryStartedEvent"
    },
    {
      "$ref": "#/$defs/testContainerDiscoveredEvent"
    },
    {
      "$ref": "#/$defs/testCatalogPublishedEvent"
    },
    {
      "$ref": "#/$defs/testRunStartedEvent"
    },
    {
      "$ref": "#/$defs/testContainerStartedEvent"
    },
    {
      "$ref": "#/$defs/testItemStartedEvent"
    },
    {
      "$ref": "#/$defs/testOutputEvent"
    },
    {
      "$ref": "#/$defs/testItemFinishedEvent"
    },
    {
      "$ref": "#/$defs/testContainerFinishedEvent"
    },
    {
      "$ref": "#/$defs/testRunFinishedEvent"
    },
    {
      "$ref": "#/$defs/coverageRunStartedEvent"
    },
    {
      "$ref": "#/$defs/coverageBuildFinishedEvent"
    },
    {
      "$ref": "#/$defs/coverageCollectionStartedEvent"
    },
    {
      "$ref": "#/$defs/coverageReportAvailableEvent"
    },
    {
      "$ref": "#/$defs/coverageRunFinishedEvent"
    },
    {
      "$ref": "#/$defs/testGenerationStateChangedEvent"
    }
  ],
  "$defs": {
    "eventBase": {
      "type": "object",
      "required": [
        "protocolVersion",
        "kind",
        "messageId",
        "sentAt",
        "sequence",
        "event",
        "taskId",
        "payloadVersion",
        "payload"
      ],
      "properties": {
        "protocolVersion": {
          "title": "EventProtocolVersionV16",
          "const": "1.6"
        },
        "kind": {
          "title": "EventKindV16",
          "const": "event"
        },
        "messageId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "sentAt": {
          "type": "string",
          "format": "date-time"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "event": {
          "title": "TaskEventNameV16",
          "enum": [
            "task.created",
            "task.started",
            "task.step_started",
            "task.output",
            "task.step_finished",
            "task.cancellation_requested",
            "artifact.created",
            "task.finished",
            "task.diagnostic",
            "test.discovery.started",
            "test.container.discovered",
            "test.catalog.published",
            "test.run.started",
            "test.container.started",
            "test.item.started",
            "test.output",
            "test.item.finished",
            "test.container.finished",
            "test.run.finished",
            "coverage.run.started",
            "coverage.build.finished",
            "coverage.collection.started",
            "coverage.report.available",
            "coverage.run.finished",
            "testGeneration.state.changed"
          ]
        },
        "taskId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "payloadVersion": {
          "const": 1
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "taskCreatedEvent": {
      "title": "TaskCreatedEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "task.created"
            },
            "payload": {
              "$ref": "#/$defs/taskCreatedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "taskStartedEvent": {
      "title": "TaskStartedEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "task.started"
            },
            "payload": {
              "$ref": "#/$defs/taskStartedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stepStartedEvent": {
      "title": "TaskStepStartedEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "task.step_started"
            },
            "payload": {
              "$ref": "#/$defs/stepStartedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "outputEvent": {
      "title": "TaskOutputEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "task.output"
            },
            "payload": {
              "$ref": "#/$defs/outputPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stepFinishedEvent": {
      "title": "TaskStepFinishedEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "task.step_finished"
            },
            "payload": {
              "$ref": "#/$defs/stepFinishedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "cancellationRequestedEvent": {
      "title": "TaskCancellationRequestedEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "task.cancellation_requested"
            },
            "payload": {
              "$ref": "#/$defs/cancellationRequestedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "artifactCreatedEvent": {
      "title": "ArtifactCreatedEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "artifact.created"
            },
            "payload": {
              "$ref": "#/$defs/artifactCreatedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "taskFinishedEvent": {
      "title": "TaskFinishedEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "task.finished"
            },
            "payload": {
              "$ref": "#/$defs/taskFinishedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "diagnosticEvent": {
      "title": "TaskDiagnosticEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "task.diagnostic"
            },
            "payload": {
              "$ref": "#/$defs/diagnosticPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "testDiscoveryStartedEvent": {
      "title": "TestDiscoveryStartedEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "test.discovery.started"
            },
            "payload": {
              "$ref": "#/$defs/testDiscoveryStartedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "testContainerDiscoveredEvent": {
      "title": "TestContainerDiscoveredEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "test.container.discovered"
            },
            "payload": {
              "$ref": "#/$defs/testContainerDiscoveredPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "testCatalogPublishedEvent": {
      "title": "TestCatalogPublishedEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "test.catalog.published"
            },
            "payload": {
              "$ref": "#/$defs/testCatalogPublishedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "testRunStartedEvent": {
      "title": "TestRunStartedEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "test.run.started"
            },
            "payload": {
              "$ref": "#/$defs/testRunStartedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "testContainerStartedEvent": {
      "title": "TestContainerStartedEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "test.container.started"
            },
            "payload": {
              "$ref": "#/$defs/testContainerStartedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "testItemStartedEvent": {
      "title": "TestItemStartedEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "test.item.started"
            },
            "payload": {
              "$ref": "#/$defs/testItemStartedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "testOutputEvent": {
      "title": "TestOutputEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "test.output"
            },
            "payload": {
              "$ref": "#/$defs/testOutputPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "testItemFinishedEvent": {
      "title": "TestItemFinishedEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "test.item.finished"
            },
            "payload": {
              "$ref": "#/$defs/testItemFinishedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "testContainerFinishedEvent": {
      "title": "TestContainerFinishedEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "test.container.finished"
            },
            "payload": {
              "$ref": "#/$defs/testContainerFinishedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "testRunFinishedEvent": {
      "title": "TestRunFinishedEventV16",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "test.run.finished"
            },
            "payload": {
              "$ref": "#/$defs/testRunFinishedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "coverageRunStartedEvent": {
      "title": "CoverageRunStartedEventV16",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "properties": { "event": { "const": "coverage.run.started" }, "payload": { "$ref": "#/$defs/coverageRunStartedPayload" } } }],
      "unevaluatedProperties": false
    },
    "coverageBuildFinishedEvent": {
      "title": "CoverageBuildFinishedEventV16",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "properties": { "event": { "const": "coverage.build.finished" }, "payload": { "$ref": "#/$defs/coverageBuildFinishedPayload" } } }],
      "unevaluatedProperties": false
    },
    "coverageCollectionStartedEvent": {
      "title": "CoverageCollectionStartedEventV16",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "properties": { "event": { "const": "coverage.collection.started" }, "payload": { "$ref": "#/$defs/coverageCollectionStartedPayload" } } }],
      "unevaluatedProperties": false
    },
    "coverageReportAvailableEvent": {
      "title": "CoverageReportAvailableEventV16",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "properties": { "event": { "const": "coverage.report.available" }, "payload": { "$ref": "#/$defs/coverageReportAvailablePayload" } } }],
      "unevaluatedProperties": false
    },
    "coverageRunFinishedEvent": {
      "title": "CoverageRunFinishedEventV16",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "properties": { "event": { "const": "coverage.run.finished" }, "payload": { "$ref": "#/$defs/coverageRunFinishedPayload" } } }],
      "unevaluatedProperties": false
    },
    "testGenerationStateChangedEvent": {
      "title": "TestGenerationStateChangedEventV16",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/eventBase" }, { "type": "object", "properties": { "event": { "const": "testGeneration.state.changed" }, "payload": { "$ref": "#/$defs/testGenerationStateChangedPayload" } } }],
      "unevaluatedProperties": false
    },
    "testGenerationStateChangedPayload": {
      "title": "TestGenerationStateChangedPayloadV16",
      "type": "object", "additionalProperties": false, "required": ["runId", "from", "to"],
      "properties": {
        "runId": { "$ref": "#/$defs/runId" },
        "from": { "$ref": "urn:unit-test-ide:protocol:v1.6:test-generation#/$defs/state" },
        "to": { "$ref": "urn:unit-test-ide:protocol:v1.6:test-generation#/$defs/state" }
      },
      "oneOf": [
        { "type": "object", "properties": { "from": { "const": "queued" }, "to": { "enum": ["baseline", "cancelled", "failed"] } } },
        { "type": "object", "properties": { "from": { "const": "baseline" }, "to": { "enum": ["analyzing", "cancelled", "failed"] } } },
        { "type": "object", "properties": { "from": { "const": "analyzing" }, "to": { "enum": ["solving", "cancelled", "failed"] } } },
        { "type": "object", "properties": { "from": { "const": "solving" }, "to": { "enum": ["rendering", "cancelled", "failed"] } } },
        { "type": "object", "properties": { "from": { "const": "rendering" }, "to": { "enum": ["validating", "cancelled", "failed"] } } },
        { "type": "object", "properties": { "from": { "const": "validating" }, "to": { "enum": ["minimizing", "rejected", "cancelled", "failed"] } } },
        { "type": "object", "properties": { "from": { "const": "minimizing" }, "to": { "enum": ["awaiting_confirmation", "rejected", "cancelled", "failed"] } } },
        { "type": "object", "properties": { "from": { "const": "awaiting_confirmation" }, "to": { "enum": ["accepted", "rejected", "cancelled", "failed"] } } }
      ]
    },
    "coverageRunStartedPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["coverageRunId", "testRunId", "catalogRevision", "repeatCount"],
      "properties": { "coverageRunId": { "$ref": "#/$defs/runId" }, "testRunId": { "$ref": "#/$defs/runId" }, "catalogRevision": { "$ref": "#/$defs/revision" }, "repeatCount": { "type": "integer", "minimum": 1, "maximum": 100 } }
    },
    "coverageBuildFinishedPayload": {
      "type": "object", "additionalProperties": false, "required": ["coverageRunId"],
      "properties": { "coverageRunId": { "$ref": "#/$defs/runId" } }
    },
    "coverageCollectionStartedPayload": {
      "type": "object", "additionalProperties": false, "required": ["coverageRunId", "testRunId"],
      "properties": { "coverageRunId": { "$ref": "#/$defs/runId" }, "testRunId": { "$ref": "#/$defs/runId" } }
    },
    "coverageReportAvailablePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["coverageRunId", "reportId", "artifactId", "completeness", "summary"],
      "properties": {
        "coverageRunId": { "$ref": "#/$defs/runId" }, "reportId": { "$ref": "#/$defs/runId" }, "artifactId": { "$ref": "#/$defs/artifactId" },
        "completeness": { "$ref": "urn:unit-test-ide:protocol:v1.6:coverage#/$defs/completeness" },
        "summary": { "$ref": "urn:unit-test-ide:protocol:v1.6:coverage#/$defs/summary" }
      }
    },
    "coverageRunFinishedPayload": {
      "type": "object", "additionalProperties": false, "required": ["coverageRunId", "outcome"],
      "properties": {
        "coverageRunId": { "$ref": "#/$defs/runId" },
        "outcome": { "enum": ["available", "partial", "unavailable", "cancelled"] },
        "reason": { "enum": ["user_cancelled", "task_timed_out", "instrumentation_failed", "build_failed", "profile_collection_failed", "merge_failed", "normalization_failed", "report_generation_failed", "persistence_failed", "service_restarted"] },
        "reportId": { "$ref": "#/$defs/runId" }
      },
      "allOf": [
        { "if": { "properties": { "outcome": { "enum": ["available", "partial"] } }, "required": ["outcome"] }, "then": { "properties": { "reportId": {} }, "required": ["reportId"], "not": { "properties": { "reason": {} }, "required": ["reason"] } } },
        { "if": { "properties": { "outcome": { "const": "unavailable" } }, "required": ["outcome"] }, "then": { "required": ["reason"], "properties": { "reason": { "enum": ["instrumentation_failed", "build_failed", "profile_collection_failed", "merge_failed", "normalization_failed", "report_generation_failed", "persistence_failed", "service_restarted"] } }, "not": { "properties": { "reportId": {} }, "required": ["reportId"] } } },
        { "if": { "properties": { "outcome": { "const": "cancelled" } }, "required": ["outcome"] }, "then": { "required": ["reason"], "properties": { "reason": { "enum": ["user_cancelled", "task_timed_out"] } }, "not": { "properties": { "reportId": {} }, "required": ["reportId"] } } }
      ]
    },
    "taskCreatedPayload": {
      "title": "TaskCreatedPayloadV16",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "queued"
        }
      }
    },
    "taskStartedPayload": {
      "title": "TaskStartedPayloadV16",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "running"
        }
      }
    },
    "stepStartedPayload": {
      "title": "TaskStepStartedPayloadV16",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "kind",
        "status"
      ],
      "properties": {
        "stepId": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_-]{0,63}$"
        },
        "kind": {
          "$ref": "#/$defs/stepKind"
        },
        "status": {
          "const": "running"
        }
      }
    },
    "outputPayload": {
      "title": "TaskOutputPayloadV16",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "stream",
        "text",
        "truncated"
      ],
      "properties": {
        "stepId": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_-]{0,63}$"
        },
        "stream": {
          "$ref": "#/$defs/outputStream"
        },
        "text": {
          "type": "string",
          "maxLength": 262144
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "stepFinishedPayload": {
      "title": "TaskStepFinishedPayloadV16",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "kind",
        "status"
      ],
      "properties": {
        "stepId": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_-]{0,63}$"
        },
        "kind": {
          "$ref": "#/$defs/stepKind"
        },
        "status": {
          "title": "TaskStepFinishedStatusV16",
          "enum": [
            "succeeded",
            "failed",
            "skipped"
          ]
        },
        "exitCode": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "errorCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "cancellationRequestedPayload": {
      "title": "TaskCancellationRequestedPayloadV16",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "cancelling"
        }
      }
    },
    "artifactCreatedPayload": {
      "title": "ArtifactCreatedPayloadV16",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "kind"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/artifactId"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "taskFinishedPayload": {
      "title": "TaskFinishedPayloadV16",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "$ref": "#/$defs/taskOutcome"
        }
      }
    },
    "diagnosticPayload": {
      "title": "TaskDiagnosticPayloadV16",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic"
      ],
      "properties": {
        "diagnostic": {
          "$ref": "urn:unit-test-ide:protocol:v1.6:diagnostic"
        }
      }
    },
    "testDiscoveryStartedPayload": {
      "title": "TestDiscoveryStartedPayloadV16",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "profileId"
      ],
