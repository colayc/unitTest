{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unit-test-ide.invalid/schemas/phase9-gates-v1.json",
  "$ref": "#/$defs/registry",
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decimalId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "utcIso": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "status": { "enum": ["PASS", "MISSING", "FAILED", "DEFERRED"] },
    "conclusion": { "enum": ["success", "failure", "cancelled", "timed_out", "action_required", "neutral", "skipped"] },
    "requirementRef": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "section"],
      "properties": { "source": { "type": "string" }, "section": { "type": "string" } }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sections"],
      "properties": { "path": { "type": "string" }, "sections": { "type": "array", "items": { "type": "string" }, "minItems": 1 } }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["commands", "workflowPath", "jobs", "artifacts"],
      "properties": {
        "commands": { "type": "array", "items": { "type": "string" } },
        "workflowPath": { "type": "string" },
        "jobs": { "type": "array", "items": { "type": "string" } },
        "artifacts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "phase", "category", "title", "requirementRefs", "disposition", "verification"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$" }, "phase": { "type": "integer", "minimum": 1, "maximum": 9 },
        "category": { "type": "string" }, "title": { "type": "string" },
        "requirementRefs": { "type": "array", "items": { "$ref": "#/$defs/requirementRef" }, "minItems": 1 },
        "disposition": { "enum": ["required", "deferred"] }, "verification": { "$ref": "#/$defs/verification" },
        "deferment": { "type": "object", "additionalProperties": false, "required": ["reason", "resumeCondition"], "properties": { "reason": { "type": "string" }, "resumeCondition": { "type": "string" } } }
      }
    },
    "registry": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "product", "repository", "allowedDeferredGateIds", "sources", "gates"],
      "properties": {
        "schemaVersion": { "const": 1 }, "product": { "type": "string" }, "repository": { "type": "string" },
        "allowedDeferredGateIds": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }, "gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } }
      }
    },
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "candidateCommit", "evaluationMode", "receiptIds"],
      "properties": { "schemaVersion": { "const": 1 }, "candidateCommit": { "$ref": "#/$defs/commit" }, "evaluationMode": { "enum": ["historical", "candidate"] }, "receiptIds": { "type": "array", "items": { "type": "string" } } }
    },
    "githubActionsReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "receiptId", "candidateCommit", "observedAt", "gateIds", "evidence"],
      "properties": {
        "schemaVersion": { "const": 1 }, "receiptId": { "type": "string" }, "candidateCommit": { "$ref": "#/$defs/commit" }, "observedAt": { "$ref": "#/$defs/utcIso" }, "gateIds": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "object", "additionalProperties": false, "required": ["kind", "repository", "workflowPath", "runId", "runAttempt", "event", "headSha", "conclusion", "jobs", "artifacts"], "properties": {
          "kind": { "const": "github-actions" }, "repository": { "type": "string" }, "workflowPath": { "type": "string" }, "runId": { "$ref": "#/$defs/decimalId" }, "runAttempt": { "type": "integer", "minimum": 1 }, "event": { "type": "string" }, "headSha": { "$ref": "#/$defs/commit" }, "conclusion": { "$ref": "#/$defs/conclusion" },
          "jobs": { "type": "array", "items": { "$ref": "#/$defs/job" } }, "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
        } }
      }
    },
    "manualApprovalReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "receiptId", "candidateCommit", "observedAt", "gateIds", "evidence"],
      "properties": {
        "schemaVersion": { "const": 1 }, "receiptId": { "type": "string" }, "candidateCommit": { "$ref": "#/$defs/commit" }, "observedAt": { "$ref": "#/$defs/utcIso" }, "gateIds": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "object", "additionalProperties": false, "required": ["kind", "approvalPath", "approvalDigest", "approvedAt", "role", "decision"], "properties": { "kind": { "const": "manual-approval" }, "approvalPath": { "type": "string" }, "approvalDigest": { "$ref": "#/$defs/digest" }, "approvedAt": { "$ref": "#/$defs/utcIso" }, "role": { "type": "string" }, "decision": { "enum": ["approved", "rejected"] } } }
      }
    },
    "receipt": { "oneOf": [{ "$ref": "#/$defs/githubActionsReceipt" }, { "$ref": "#/$defs/manualApprovalReceipt" }] },
    "job": { "type": "object", "additionalProperties": false, "required": ["name", "conclusion"], "properties": { "name": { "type": "string" }, "conclusion": { "$ref": "#/$defs/conclusion" } } },
    "p7Report": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "gateId", "candidateCommit", "sourceCommit", "runAttempt", "producer", "executionMode", "outcome", "startedAt", "finishedAt", "checks"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "gateId": { "enum": ["P7-COVERAGE-UI-AND-SOURCE-DECORATION", "P7-HISTORY-AND-ARTIFACT-BROWSER", "P7-MAIN-USER-JOURNEY", "P7-MOCK-CONFIGURATION-UX"] },
        "candidateCommit": { "$ref": "#/$defs/commit" },
        "sourceCommit": { "$ref": "#/$defs/commit" },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "producer": { "const": "code-oss-extension-host" },
        "executionMode": { "enum": ["activation-only", "terminal-free-journey", "ui-contract"] },
        "outcome": { "enum": ["passed", "failed", "skipped"] },
        "startedAt": { "$ref": "#/$defs/utcIso" },
        "finishedAt": { "$ref": "#/$defs/utcIso" },
        "checks": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "status"],
            "properties": {
              "id": { "enum": ["activation", "artifact-browser", "coverage-tree", "coverage-ui", "discover-tests", "history-browser", "html-report-offline", "mock-configuration", "mock-failure-navigation", "protocol-artifact-integrity", "run-tests", "service-lifecycle", "source-decoration", "stub-configuration", "terminal-free"] },
              "status": { "enum": ["passed", "failed", "skipped"] }
            }
          }
        }
      }
    },
    "p8ProducerArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "name", "digest"],
      "properties": {
        "kind": { "enum": ["appimagetool", "linux-runtime", "provenance", "windows-runtime"] },
        "id": { "$ref": "#/$defs/decimalId" },
        "name": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "p8PackageArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "id", "name", "digest"],
      "properties": {
        "platform": { "enum": ["linux", "windows"] },
        "id": { "$ref": "#/$defs/decimalId" },
        "name": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "p8Outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {
          "enum": [
            "appimage-envelope", "appimage-licenses", "appimage-manifest", "appimage-package", "appimage-payload", "appimage-runtime", "appimagetool",
            "fixed-code-oss-source", "install-lifecycle-linux", "install-lifecycle-windows", "install-linux", "install-windows", "launch-linux", "launch-windows",
            "license-audit-linux", "license-audit-windows", "msix-licenses", "msix-manifest", "msix-package", "msix-payload", "msix-runtime", "msix-unsigned",
            "provenance", "rollback-linux", "rollback-windows", "runtime-linux", "runtime-windows", "uninstall-linux", "uninstall-windows", "upgrade-linux", "upgrade-windows"
          ]
        },
        "status": { "enum": ["passed", "failed", "skipped"] }
      }
    },
    "p8Report": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "gateId", "candidateCommit", "sourceCommit", "runId", "runAttempt", "producerRun", "executionMode", "outcome", "outcomes"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "gateId": {
          "enum": [
            "P8-INSTALL-LIFECYCLE-LINUX", "P8-INSTALL-LIFECYCLE-WINDOWS", "P8-LICENSE-AUDIT", "P8-LINUX-APPIMAGE-PACKAGE", "P8-QUALIFICATION-UNSIGNED", "P8-RUNTIME-PRODUCER-PROVENANCE", "P8-WINDOWS-MSIX-PACKAGE"
          ]
        },
        "candidateCommit": { "$ref": "#/$defs/commit" },
        "sourceCommit": { "$ref": "#/$defs/commit" },
        "runId": { "$ref": "#/$defs/decimalId" },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "producerRun": {
          "type": "object", "additionalProperties": false,
          "required": ["workflowPath", "sourceCommit", "codeOssCommit", "runId", "runAttempt", "artifacts"],
          "properties": {
            "workflowPath": { "const": ".github/workflows/release-inputs.yml" },
            "sourceCommit": { "$ref": "#/$defs/commit" },
            "codeOssCommit": { "const": "b1c0a14de1414fcdaa400695b4db1c0799bc3124" },
            "runId": { "$ref": "#/$defs/decimalId" },
            "runAttempt": { "type": "integer", "minimum": 1 },
            "artifacts": { "type": "array", "items": { "$ref": "#/$defs/p8ProducerArtifact" }, "minItems": 4, "maxItems": 4 }
          }
        },
        "executionMode": { "enum": ["producer", "unsigned-foundation"] },
        "releaseVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$", "maxLength": 128 },
        "packages": { "type": "array", "items": { "$ref": "#/$defs/p8PackageArtifact" }, "minItems": 2, "maxItems": 2 },
        "signing": {
          "type": "object", "additionalProperties": false,
          "required": ["signature_required", "signature_outcome"],
          "properties": {
            "signature_required": { "enum": ["0", "1"] },
            "signature_outcome": { "enum": ["not-required", "verified"] }
          }
        },
        "outcome": { "enum": ["passed", "failed", "skipped"] },
        "outcomes": { "type": "array", "items": { "$ref": "#/$defs/p8Outcome" }, "minItems": 1, "maxItems": 16 }
      }
    },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["id", "name", "digest", "expired"], "properties": { "id": { "$ref": "#/$defs/decimalId" }, "name": { "type": "string" }, "digest": { "$ref": "#/$defs/digest" }, "expired": { "type": "boolean" }, "report": { "oneOf": [{ "$ref": "#/$defs/p7Report" }, { "$ref": "#/$defs/p8Report" }] } } },
    "matrixGate": { "type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": { "id": { "type": "string" }, "status": { "$ref": "#/$defs/status" }, "receiptId": { "type": "string" }, "artifactAvailability": { "enum": ["available", "expired", "missing"] }, "reason": { "const": "candidate-descendant-changed-tested-content" } } },
    "matrix": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "catalogComplete", "releaseReady", "evaluationMode", "candidateCommit", "currentCommit", "counts", "gates"], "properties": { "schemaVersion": { "const": 1 }, "catalogComplete": { "type": "boolean" }, "recordedByCommit": { "$ref": "#/$defs/commit" }, "releaseReady": { "type": "boolean" }, "evaluationMode": { "enum": ["historical", "candidate"] }, "candidateCommit": { "$ref": "#/$defs/commit" }, "currentCommit": { "$ref": "#/$defs/commit" }, "counts": { "type": "object", "additionalProperties": false, "required": ["pass", "missing", "failed", "deferred"], "properties": { "pass": { "type": "integer", "minimum": 0 }, "missing": { "type": "integer", "minimum": 0 }, "failed": { "type": "integer", "minimum": 0 }, "deferred": { "type": "integer", "minimum": 0 } } }, "gates": { "type": "array", "items": { "$ref": "#/$defs/matrixGate" }, "minItems": 1 } } },
    "runSnapshot": { "type": "object", "additionalProperties": false, "required": ["id", "run_attempt", "event", "head_sha", "status", "conclusion", "path", "repository"], "properties": { "id": { "type": "integer", "minimum": 1 }, "run_attempt": { "type": "integer", "minimum": 1 }, "event": { "type": "string" }, "head_sha": { "$ref": "#/$defs/commit" }, "status": { "type": "string" }, "conclusion": { "$ref": "#/$defs/conclusion" }, "path": { "type": "string" }, "repository": { "type": "object", "additionalProperties": false, "required": ["full_name"], "properties": { "full_name": { "type": "string" } } } } },
    "jobSnapshot": { "type": "object", "additionalProperties": false, "required": ["total_count", "jobs"], "properties": { "total_count": { "type": "integer", "minimum": 0 }, "jobs": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "run_id", "name", "status", "conclusion"], "properties": { "id": { "type": "integer", "minimum": 1 }, "run_id": { "type": "integer", "minimum": 1 }, "name": { "type": "string" }, "status": { "type": "string" }, "conclusion": { "$ref": "#/$defs/conclusion" } } } } } },
    "artifactSnapshot": { "type": "object", "additionalProperties": false, "required": ["total_count", "artifacts"], "properties": { "total_count": { "type": "integer", "minimum": 0 }, "artifacts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "digest", "expired", "workflow_run"], "properties": { "id": { "type": "integer", "minimum": 1 }, "name": { "type": "string" }, "digest": { "type": "string" }, "expired": { "type": "boolean" }, "workflow_run": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "integer", "minimum": 1 } } } } } } } }
  }
}
