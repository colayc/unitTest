{
  "version": 6,
  "include": [
    "included.json"
  ],
  "configurePresets": [
    {
      "name": "project-debug",
      "displayName": "Project Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/debug"
    },
    {
      "name": "not-listed-for-this-platform",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/other",
      "condition": {
        "type": "const",
        "value": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "project-build",
      "displayName": "Project Build",
      "configurePreset": "project-debug",
      "configuration": "Debug"
    },
    {
      "name": "not-listed-build",
      "configurePreset": "not-listed-for-this-platform"
    }
  ]
}
